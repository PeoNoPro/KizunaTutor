# ==============================================================================
# KizunaTutor Production Environment Template
# Copy to .env and replace all placeholder values before running:
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml up -d --build
# ==============================================================================

# --- Database (PostgreSQL / Supabase Pooler) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.your_project_ref
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- JWT Authentication (minimum 256-bit / 32+ chars secret) ---
APP_JWT_SECRET=CHANGE_ME_256_BIT_HEX_OR_BASE64_JWT_SECRET

# --- Transactional Email (SMTP / Brevo) ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username@example.com
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_SENDER_EMAIL=noreply@your-domain.com

# --- Frontend Origins & Public URL (CORS + staff invite links) ---
APP_FRONTEND_ORIGINS=https://your-domain.com
APP_FRONTEND_URL=https://your-domain.com

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://your-domain.com/login/oauth2/code/google

# --- VNPay Payment Gateway (optional; leave TMN_CODE/HASH_SECRET blank if unused) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://your-domain.com/tutor/membership/result

# --- Cloudflare R2 Object Storage (optional; set R2_ENABLED=true to enable) ---
R2_ENABLED=false
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=kizuna-tutor
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- JVM Options ---
JAVA_OPTS=-Xmx512m -Xms256m

# --- Cloudflare Tunnel (optional; used when running `--profile tunnel`) ---
CLOUDFLARE_TUNNEL_TOKEN=
